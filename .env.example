# Copia este archivo como .env y rellena las credenciales de Turso.
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu-token-de-turso

# false = modo local (staging SQLite, sin consultar ni escribir en Turso)
# true  = modo Turso (lecturas y escrituras cuando se pida)
TURSO_ENABLED=false
